# Copy values into GitHub Secrets / Variables or pass with --dart-define. NEVER commit real values.
# These are compile-time values read via String.fromEnvironment in lib/core/config.dart.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY   # anon key only. NEVER the service_role key.
ADS_ENABLED=false                                  # master switch; ads never load when false
STARTIO_TEST_MODE=true                             # keep true until you intentionally go live
STARTIO_APP_ID=209978600                 # used only by tool/patch_android.py (AndroidManifest)
AI_PROXY_URL=                                      # optional: URL of your secure AI proxy (empty = AI off)
